# IDE
# Ignore IntelliJ IDEA project files
/AI-dianping-backend/.idea/

# Build output
# Ignore Maven build output directory
/AI-dianping-backend/target/

# NGINX runtime files
# Ignore NGINX logs, temp files and the executable
/AI-dianping-frontend/logs/
/AI-dianping-frontend/temp/
/AI-dianping-frontend/nginx.exe
/AI-dianping-frontend/docs/
/AI-dianping-frontend/contrib/
/AI-dianping-frontend/conf/*
!/AI-dianping-frontend/conf/nginx.conf
!/AI-dianping-frontend/conf/mime.types

# Local configuration and credentials
.env
*.local

# Runtime and editor files
*.log
.vscode/

# OS generated files
.DS_Store
Thumbs.db
